<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Spaceline</title>
  <link rel="stylesheet" href="/assets/style.css?v=0.9.6">
</head>
<body>
  <section id="authGate" class="auth-gate" aria-labelledby="authTitle">
    <div class="auth-code-field" aria-hidden="true">
      <span>{ }</span><span>const</span><span>&lt;/&gt;</span><span>API</span><span>function</span><span>=&gt;</span><span>01</span><span>import</span><span>async</span><span>return</span><span>git</span><span>[ ]</span>
    </div>
    <div class="auth-layout">
      <section class="auth-intro" aria-label="About Spaceline">
        <div class="auth-brand">
          <img class="auth-mark" src="/assets/spaceline-mark.svg" alt="Spaceline">
          <div><strong>SPACELINE</strong><span>INTELLIGENCE WORKSPACE</span></div>
        </div>
        <div class="auth-intro-content">
          <div class="auth-intro-kicker"><span class="auth-live-dot"></span> YOUR IDEAS, IN ONE PLACE</div>
          <h2>One space for<br><span>every way you work.</span></h2>
          <p class="auth-intro-copy">Bring AI conversations, coding projects, research and creative work into one focused workspace. Choose your tools, keep your context, and move from idea to execution.</p>
          <div class="auth-feature-list">
            <div class="auth-feature"><span class="auth-feature-icon">✳</span><span><strong>Work with your AI models</strong><small>Bring your preferred providers into one flow.</small></span></div>
            <div class="auth-feature"><span class="auth-feature-icon">⌘</span><span><strong>Build without breaking focus</strong><small>Projects, files and a coding workbench together.</small></span></div>
            <div class="auth-feature"><span class="auth-feature-icon">↗</span><span><strong>Research, organize and create</strong><small>Keep useful work close to the conversation.</small></span></div>
          </div>
        </div>
        <div class="auth-intro-footer"><span>MADE FOR DEEP WORK</span><span class="auth-footer-line"></span><span>SPACELINE 0.9.6</span></div>
      </section>

      <div class="auth-card" aria-describedby="authMessage">
        <div class="auth-card-topline"><span class="auth-card-mark">✳</span><span>YOUR WORKSPACE STARTS HERE</span></div>
        <div class="auth-eyebrow">WELCOME TO SPACELINE</div>
        <h1 id="authTitle">Welcome back</h1>
        <p id="authDescription" class="auth-description">Sign in to continue to your workspace.</p>
        <div class="auth-socials">
          <button id="googleSignIn" class="google-signin" type="button"><span class="google-mark" aria-hidden="true">G</span><span>Continue with Google</span><span class="auth-spinner" aria-hidden="true"></span></button>
          <button id="githubSignIn" class="github-signin" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.04c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.91.1-.71.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.11-1.45 3.04-1.15 3.04-1.15.61 1.54.23 2.68.12 2.96.71.78 1.14 1.78 1.14 3.01 0 4.3-2.62 5.24-5.12 5.51.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.53A11.1 11.1 0 0 0 12 .9Z"/></svg><span>Continue with GitHub</span><span class="auth-spinner" aria-hidden="true"></span></button>
        </div>
        <div class="auth-or" aria-hidden="true"><span></span>or continue with email<span></span></div>
        <form id="signInForm" class="auth-form" novalidate>
          <label for="signInEmail">Email</label>
          <input id="signInEmail" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com">
          <label for="signInPassword">Password</label>
          <div class="password-field"><input id="signInPassword" name="password" type="password" autocomplete="current-password" required minlength="6" placeholder="Enter your password"><button class="password-toggle" type="button" data-password-toggle="signInPassword" aria-label="Show password">Show</button></div>
          <div class="auth-options"><label class="remember-option"><input id="rememberMe" type="checkbox" checked> <span>Remember me</span></label><button id="forgotPassword" class="text-action" type="button">Forgot password?</button></div>
          <button id="emailSignIn" class="auth-submit" type="submit"><span>Sign in</span><span class="auth-spinner" aria-hidden="true"></span></button>
        </form>
        <form id="createAccountForm" class="auth-form hidden" novalidate>
          <label for="createEmail">Email</label>
          <input id="createEmail" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com">
          <label for="createPassword">Create password</label>
          <div class="password-field"><input id="createPassword" name="password" type="password" autocomplete="new-password" required minlength="6" placeholder="At least 6 characters"><button class="password-toggle" type="button" data-password-toggle="createPassword" aria-label="Show password">Show</button></div>
          <button id="createAccount" class="auth-submit" type="submit"><span>Create account</span><span class="auth-spinner" aria-hidden="true"></span></button>
        </form>
        <p id="authMessage" class="auth-message" role="status" aria-live="polite">Secure sign-in powered by Firebase Authentication.</p>
        <p class="auth-switch"><span id="switchPrompt">New to Spaceline?</span> <button id="switchAuthMode" class="text-action" type="button">Create account</button></p>
        <p class="auth-footnote">Your Google or GitHub account is used for Spaceline identity only. It does not sign you into the embedded browser.</p>
      </div>
    </div>
  </section>
  <div id="app" class="app-shell" hidden>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-topline">
        <div class="brand-lockup" aria-label="Spaceline"><img class="brand-mark" src="/assets/spaceline-mark.svg" alt=""><div class="brand-copy"><strong>SPACELINE</strong><span>INTELLIGENCE WORKSPACE</span></div></div>
        <div class="sidebar-top-actions"><button class="icon-button" id="backBtn" title="Back" aria-label="Go back">‹</button><button class="icon-button" id="forwardBtn" title="Forward" aria-label="Go forward">›</button><button class="icon-button" id="sidebarToggle" title="Collapse sidebar" aria-label="Toggle sidebar">☰</button></div>
      </div>
      <div class="mode-switch" role="tablist" aria-label="Workspace mode">
        <button class="mode active" data-mode="cowork">✣ <span>Cowork</span></button>
        <button class="mode" data-mode="code">‹› <span>Code</span></button>
      </div>
      <nav class="primary-nav" aria-label="Main navigation">
        <button class="nav-item" data-view="chat"><span class="nav-icon">＋</span><span>New</span></button>
        <button class="nav-item" data-view="search"><span class="nav-icon">⌕</span><span>Search</span></button>
        <button class="nav-item" data-view="projects"><span class="nav-icon">▱</span><span>Projects</span></button>
        <button class="nav-item" data-view="artifacts"><span class="nav-icon">▣</span><span>Artifacts</span></button>
        <button class="nav-item image-studio-nav" data-view="images"><span class="nav-icon">✧</span><span>Image Studio</span></button>
        <button class="nav-item" data-view="scheduled"><span class="nav-icon">◷</span><span>Scheduled</span></button>
        <button class="nav-item" data-view="customize"><span class="nav-icon">♧</span><span>Customize</span></button>
      </nav>
      <div class="sidebar-section-head"><span>Tasks</span><button class="icon-button small" id="refreshChats" title="Refresh chats">☷</button></div>
      <div class="task-list" id="taskList"><div class="quiet-note">Your recent chats will appear here.</div></div>
      <button class="view-all" id="viewAllChats">View all</button>
      <div class="sidebar-footer">
        <button id="accountMenuButton" class="account-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
          <span class="user-avatar" id="accountAvatar">N</span>
          <span class="user-info"><strong id="accountName">Spaceline account</strong><span id="serverStatus">Connecting…</span></span>
        </button>
        <div id="accountMenu" class="account-menu hidden" role="menu">
          <div class="account-menu-profile"><strong id="accountMenuName">Spaceline account</strong><span id="accountEmail"></span></div>
          <button id="switchAccount" type="button" role="menuitem">Switch account</button>
          <button id="signOut" type="button" role="menuitem">Sign out</button>
        </div>
        <button class="icon-button small" id="footerSettings" title="Provider settings">⌄</button>
      </div>
    </aside>

    <main class="main-area">
      <header class="topbar">
        <div class="breadcrumb" id="breadcrumb"><span class="crumb-muted">Workspace</span><span class="crumb-sep">/</span><strong id="viewTitle">New chat</strong></div>
        <div class="topbar-actions">
          <button class="quiet-button preview-launcher" id="openLivePreview" type="button" title="Open the live project preview">◫ Preview</button>
          <button class="image-studio-launcher" id="openImageStudio" type="button" title="Open standalone image generation studio"><span class="image-studio-launcher-icon">✧</span><span>Image Studio</span></button>
          <button class="quiet-button" id="quickProvider">No model selected</button>
          <button class="icon-button command-palette-trigger" id="openCommandPalette" type="button" title="Command palette · Ctrl+K" aria-label="Open command palette">⌘</button>
          <button class="icon-button" id="openCustomize" title="Customize" aria-label="Customize">⚙</button>
        </div>
      </header>
      <section id="viewRoot" class="view-root"></section>
    </main>
  </div>

  <div id="modalLayer" class="modal-layer hidden" aria-hidden="true"></div>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <div id="spacelineCursor" class="spaceline-cursor" aria-hidden="true"></div>
  <script>
    window.SPACELINE_TOKEN = "__SPACELINE_TOKEN__";
    window.SPACELINE_FIREBASE_CONFIG = __FIREBASE_CONFIG__;
    window.SPACELINE_FIREBASE_CONFIGURED = __FIREBASE_CONFIGURED__;
    window.SPACELINE_FIREBASE_MISSING = __FIREBASE_MISSING__;
    window.SPACELINE_FIREBASE_BACKEND_READY = __FIREBASE_BACKEND_READY__;
  </script>
  <!-- The authenticated workspace loads /assets/app.js?v=0.9.6 only after Firebase confirms a signed-in user. -->
  <script type="module" src="/assets/auth.js?v=0.9.6"></script>
</body>
</html>
